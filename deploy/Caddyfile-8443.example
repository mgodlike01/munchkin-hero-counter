# Standalone Caddy config for Xray occupying 443.
# Requires an already issued, publicly trusted certificate for this domain.
# Obtain/renew it through DNS-01 or your existing certificate management.
# This config does not request certificates and does not bind 80/443.
# Do not replace an existing Caddyfile with this example.
{
    admin off
    auto_https off
}

https://hero.example.com:8443 {
    tls /path/to/fullchain.pem /path/to/privkey.pem
    encode zstd gzip
    reverse_proxy 127.0.0.1:18080
}
