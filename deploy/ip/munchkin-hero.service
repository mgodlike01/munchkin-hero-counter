[Unit]
Description=Munchkin Hero PWA on HTTPS port 8443
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=munchkin-web
Group=munchkin-web
StateDirectory=munchkin-hero
StateDirectoryMode=0750
WorkingDirectory=/var/lib/munchkin-hero
Environment=XDG_DATA_HOME=/var/lib/munchkin-hero/data
Environment=XDG_CONFIG_HOME=/var/lib/munchkin-hero/config
Environment=GOMEMLIMIT=192MiB
ExecStart=/opt/munchkin-hero/bin/caddy run --config /opt/munchkin-hero/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/munchkin-hero
# Restrict this service, without changing global firewall rules or other services.
SocketBindDeny=tcp:443
SocketBindDeny=udp:443
MemoryMax=256M
CPUWeight=50

[Install]
WantedBy=multi-user.target
