{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://__PUBLIC_IP__:8443 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	root * /opt/munchkin-hero/site
	encode zstd gzip

	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}

# The ACME HTTP-01 handler takes precedence over this redirect.
http://__PUBLIC_IP__:80 {
	redir https://__PUBLIC_IP__:8443{uri} 308
}
